{
  "name": "b-synctext",
  "private": true,
  "description": "B-SyncText : éditeur de documents partagé en temps réel, déployé sur AWS",
  "type": "module",
  "workspaces": [
    "src/commun",
    "src/web",
    "src/edition",
    "src/api",
    "src/telechargement"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "couverture": "vitest run --coverage",
    "verifier": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
