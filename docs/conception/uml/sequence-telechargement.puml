@startuml sequence-telechargement
' UC-11 — réservation puis téléchargement (C-1, C-3, C-6)
skinparam shadowing false
autonumber
actor Visiteur as V
participant "Page E-07" as P
participant "Lambda\ntelechargement" as L
database DynamoDB as D
collections "S3 donnees" as S

V -> P : ouvre le lien
P -> L : POST /api/liens/{id}/demandes
L -> D : Liens : disponibles - 1\nSI disponibles > 0 ET etat = actif
alt écriture acceptée
  L -> D : Reservations : ticket, statut = reserve,\nexpireA = maintenant + 60 s
  L --> P : 200 { etat: "pret", ticket }
  P -> L : GET /api/liens/{id}/fichier?ticket=…
  L -> D : transaction : Reservation reserve → compte\nSI expireA > maintenant ; Liens : comptes + 1
  L -> D : Liens : numerotation + 1 → k
  L -> D : Journal : dernière modification (lecture forte)
  L -> S : PDF de base pour cet état ? (sinon le générer et le ranger)
  L --> P : application/pdf « exemplaire k / N »
  opt k = N
    L -> D : Liens : etat = epuise, notifie = vrai SI notifie = faux
    L -> L : e-mail SES au créateur (une seule fois)
  end
else condition refusée (disponibles = 0)
  L -> D : réservations expirées ? remise en stock (transaction)
  L --> P : 200 { etat: "patientez" } ou { etat: "epuise" }
else saturation (429)
  L --> P : 429, la page affiche « Patientez »
end
@enduml
