@startuml donnees
' Modèle de données (tables DynamoDB) — voir 06-donnees-et-api.md
skinparam shadowing false
hide circle
hide empty methods

class Redacteur <<Redacteurs>> {
  email : clé
  nom
  bloqueJusqua
  motifBlocage
}
class Credit <<Credits>> {
  email : clé
  jour AAAA-MM-JJ en WAT : clé de tri
  restant
}
class Document <<Documents>> {
  docId : clé
  titre
  creeLe
  jetonInvitation
  connectes, presenceMaj
}
class Membre <<Membres>> {
  docId : clé
  email : clé de tri
  role : principal | proprietaire | membre
  nommeLe
}
class Modification <<Journal>> {
  docId : clé
  horodatage#id : clé de tri
  miseAJour : Yjs, binaire
  auteur
  caracteres
}
class Version <<Versions>> {
  docId : clé
  horodatage : clé de tri
  numero : v3 ou v3.1
  nom, type : auto | manuelle | restauration
  cleS3
}
class Lien <<Liens>> {
  lienId : clé
  docId, creePar
  n, disponibles, comptes, numerotation
  etat : actif | epuise
  notifie
}
class Reservation <<Reservations>> {
  ticket : clé
  lienId
  statut : reserve | compte | expire
  expireA
  numero
}

Redacteur "1" -- "*" Credit : un par jour
Redacteur "1" -- "*" Membre
Document "1" -- "*" Membre
Document "1" -- "*" Modification
Document "1" -- "*" Version
Document "1" -- "*" Lien
Lien "1" -- "*" Reservation
@enduml
