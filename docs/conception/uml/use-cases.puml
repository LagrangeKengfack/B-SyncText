@startuml use-cases
' Diagramme des cas d'utilisation — voir 02-use-cases.md
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor "Rédacteur" as R
actor "Propriétaire" as P
actor "Visiteur" as V
actor "Association" as A
actor "Système" as S <<système>>

P --|> R

rectangle "Éditeur de documents partagé" {
  usecase "UC-01 Entrer (nom + e-mail)" as UC01
  usecase "UC-02 Créer un document" as UC02
  usecase "UC-03 Donner accès (e-mail, lien),\nnommer un propriétaire" as UC03
  usecase "UC-04 Lister ses documents" as UC04
  usecase "UC-05 Écrire à plusieurs\nen temps réel" as UC05
  usecase "UC-06 Voir présence\net curseurs" as UC06
  usecase "UC-07 Consulter son crédit" as UC07
  usecase "UC-08 Consulter les versions" as UC08
  usecase "UC-09 Restaurer une version" as UC09
  usecase "UC-10 Créer un lien\nde téléchargement" as UC10
  usecase "UC-11 Télécharger le PDF\npar le lien" as UC11
  usecase "UC-12 Notifier le créateur\n(lien épuisé)" as UC12
  usecase "UC-13 Consulter le\ntableau de bord" as UC13
  usecase "UC-14 Recharger les crédits" as UC14
  usecase "UC-15 Détecter et bloquer\nun abus" as UC15
  usecase "Vérifier et débiter\nle crédit" as DEB
}

R --> UC01
R --> UC02
R --> UC04
R --> UC05
R --> UC07
R --> UC08
P --> UC09
R --> UC10
P --> UC03
V --> UC11
A --> UC13
S --> UC14
S --> UC15
S <-- UC12

UC05 .> UC06 : <<include>>
UC05 .> DEB : <<include>>
UC09 .> UC08 : <<include>>
UC11 .> UC12 : <<extend>>\n(dernier exemplaire)
UC15 .> UC05 : <<extend>>\n(refus répétés)
@enduml
